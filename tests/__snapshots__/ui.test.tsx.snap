exports[`plugin UI navigation and capability states > locks Chat markup and keeps the execution controller above page rendering > approved Chat page markup 1`] = `"<main class="app-shell is-chat-view"><header class="topbar"><div class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 5h14v14H5z"></path><path d="M9 5v14M5 9h14"></path></svg></div><div class="brand-copy"><div class="brand-title">Figma AI Design Engine</div><div class="brand-subtitle">Structured, editable design workflows</div></div><span class="connection-chip topbar-connection-chip  is-reconnecting" aria-live="polite" aria-label="Connection status: Reconnecting"><span class="connection-dot" aria-hidden="true"></span><span>Reconnecting</span></span><button class="drawer-button " type="button" aria-expanded="false" aria-haspopup="dialog" aria-label="Open page drawer"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14"></path></svg><span>Menu</span></button></header><section class="chat-home" aria-labelledby="chat-title"><h1 id="chat-title" class="sr-only">AI Chat</h1><div class="chat-toolbar"><button class="secondary-action chat-new-button" type="button" disabled="" title="Start a separate saved conversation."><span class="chat-new-button-icon" aria-hidden="true">+</span>New chat</button></div><div class="chat-scroll-region"><div class="chat-transcript" role="log" aria-live="polite" aria-relevant="additions text"><div class="chat-welcome"><span class="section-kicker">YOUR DESIGN ASSISTANT</span><h2>What would you like to make?</h2><p>Try “Create a mobile storefront frame” or “Make the title on my selected frame right-aligned.”</p></div></div></div><form class="chat-composer"><label for="chat-input">Message</label><textarea id="chat-input" maxLength="8000" rows="3" dir="auto" placeholder="Describe a design or change… / تغییر موردنظرت را توضیح بده…" disabled="" aria-describedby="chat-help"></textarea><div class="chat-composer-footer"><span id="chat-help" class="sr-only">Press Enter to send. Press Shift+Enter for a new line.</span><div class="chat-composer-tools"><details class="chat-more-menu"><summary class="chat-more-trigger" aria-controls="more-options-panel"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="4" cy="10" r="1"></circle><circle cx="10" cy="10" r="1"></circle><circle cx="16" cy="10" r="1"></circle></svg><span>More</span></summary><div class="more-options-panel" id="more-options-panel" role="region" aria-label="More options"><button class="more-option" type="button"><span class="more-option-icon" aria-hidden="true">✦</span><span class="more-option-copy"><span>Generation Options</span><small>Screens, target, style, and model</small></span></button><button class="more-option" type="button"><span class="more-option-icon" aria-hidden="true">◷</span><span class="more-option-copy"><span>Generation Progress</span><small>Live task stages and recovery</small></span></button><button class="more-option" type="button"><span class="more-option-icon" aria-hidden="true">✓</span><span class="more-option-copy"><span>Result &amp; Preview</span><small>Confirmed saved screens and actions</small></span></button><button class="more-option" type="button"><span class="more-option-icon" aria-hidden="true">▱</span><span class="more-option-copy"><span>Layers &amp; Structure</span><small>Verified task-owned Figma hierarchy</small></span></button><button class="more-option" type="button"><span class="more-option-icon" aria-hidden="true">◈</span><span class="more-option-copy"><span>Brand Kit</span><small>Brand colors and typography</small></span></button><button class="more-option" type="button"><span class="more-option-icon" aria-hidden="true">✧</span><span class="more-option-copy"><span>Skills</span><small>Local design guidance</small></span></button><button class="more-option" type="button"><span class="more-option-icon" aria-hidden="true">▦</span><span class="more-option-copy"><span>Design System</span><small>Document-scoped native tokens</small></span></button><button class="more-option" type="button"><span class="more-option-icon" aria-hidden="true">▧</span><span class="more-option-copy"><span>Asset Library</span><small>Local images, SVGs, and provenance</small></span></button><button class="more-option" type="button"><span class="more-option-icon" aria-hidden="true">≋</span><span class="more-option-copy"><span>Activity &amp; Diagnostics</span><small>Task stages and safe recovery data</small></span></button><button class="more-option" type="button"><span class="more-option-icon" aria-hidden="true">⬡</span><span class="more-option-copy"><span>Quality Report</span><small>Measured preflight and native findings</small></span></button><button class="more-option" type="button"><span class="more-option-icon" aria-hidden="true">{}</span><span class="more-option-copy"><span>JSON Advanced</span><small>Offline validate, edit, and apply</small></span></button><button class="more-option" type="button"><span class="more-option-icon" aria-hidden="true">?</span><span class="more-option-copy"><span>Help &amp; Guide</span><small>How this plugin handles native changes</small></span></button><button class="more-option" type="button"><span class="more-option-icon" aria-hidden="true">ⓘ</span><span class="more-option-copy"><span>About</span><small>Version and project information</small></span></button></div></details><details class="chat-model-menu" id="chat-model-menu"><summary class="chat-model-shortcut" aria-controls="chat-model-options" aria-expanded="false"><small>MODEL</small><strong>No model selected</strong></summary><div class="chat-model-options" id="chat-model-options" role="group" aria-label="Available models"><div class="chat-model-options-state" role="status"><span>Connect an account in Settings to load available models.</span><button type="button">Open Settings</button></div></div></details></div><button type="submit" class="primary-action" disabled="">Send</button></div></form></section></main>"`;
